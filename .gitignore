# ============================================================
# 📦 Dependencies
# ============================================================
node_modules/


# ============================================================
# 🔒 data/ — keep folder, ignore contents
# ============================================================
data/*
!data/.gitkeep


# ============================================================
# 🔒 vault/ — keep full folder tree, ignore all contents
# ============================================================
# vault/**            → ignore everything recursively
# !vault/**/          → but re-include every folder (structure survives)
# !vault/**/.gitkeep  → and keep the .gitkeep placeholders
vault/**
!vault/**/
!vault/**/.gitkeep


# ============================================================
# 🖼️ assets/covers/ — keep folder, ignore contents
# ============================================================
assets/covers/*
!assets/covers/.gitkeep
assets/previews/*
!assets/previews/.gitkeep


# ============================================================
# ⚙️ Phoenix Code — auto-generated, machine-specific
# ============================================================
jsconfig.json
.phcode.json


# ============================================================
# 🧹 OS junk + editor folders + temp files
# ============================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
*.tmp



concepts/
.env